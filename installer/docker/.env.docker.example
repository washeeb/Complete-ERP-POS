# Settings for the Docker installation. Copy to installer/docker/.env and fill in. Never commit or e-mail the real file.
APP_NAME="Ervanta"
APP_ENV=production
APP_DEBUG=false
# The address people use, e.g. https://erp.yourcompany.com (put HTTPS in front with your host's load balancer or Caddy/Traefik).
APP_URL=http://localhost
# Created on first start if empty (and printed in the log once). Then copy it here — never change it afterwards.
APP_KEY=
ERP_AUDIT_KEY=
BACKUP_PASSPHRASE=

DB_CONNECTION=pgsql
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=change-me-to-a-long-random-password

ERP_NODE_ROLE=hq
ERP_NODE_ID=HQ

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=erp
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me-too
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=erp@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Pilot support (Phase 14): problem reports and the evening pilot report, when the go-live plan names no address.
ERP_SUPPORT_EMAIL=

# The product brand (normally as delivered): name, who supplies it, its website. Artwork: branding/product, npm run brand.
BRAND_NAME=Ervanta
BRAND_VENDOR=
BRAND_WEBSITE=

HTTP_PORT=80
REVERB_PUBLIC_PORT=8080
BACKUP_HOST_DIR=./backups

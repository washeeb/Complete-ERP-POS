{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SES Labs Till",
  "version": "0.28.0",
  "identifier": "app.seslabs.till",
  "build": {
    "frontendDist": "setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SyncLytics",
    "shortDescription": "SES Labs till",
    "longDescription": "The SES Labs till with silent receipt printing (ESC/POS), cash drawer and scale support. It opens the till from your business server.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "copyright": "Copyright © SyncLytics"
  }
}

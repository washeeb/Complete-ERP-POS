{
  "name": "pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.office.config.ts --outDir ../dist-office --emptyOutDir",
    "build:server": "tsc -b && vite build --mode server",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && vitest run -c vite.office.config.ts",
    "e2e": "playwright test",
    "manual": "node scripts/manual.mjs",
    "notes": "node scripts/notes.mjs",
    "manual:screens": "node scripts/manual-screens.mjs",
    "check:layout": "node scripts/layout-check.mjs",
    "training": "node scripts/training.mjs",
    "pentest": "node scripts/training.mjs pentest ^0[12]-",
    "brand": "node scripts/brand.mjs",
    "brand:loader": "node scripts/brand-loader.mjs",
    "desktop:build": "cd ../desktop && node ../pos/node_modules/@tauri-apps/cli/tauri.js build",
    "build:office": "tsc -b && vite build -c vite.office.config.ts",
    "dev:office": "vite -c vite.office.config.ts",
    "check:office": "node scripts/office-check.mjs",
    "office:routes": "node scripts/office-routes.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.1",
    "@fluentui/react-icons": "2.0.345",
    "dexie": "^4.4.6",
    "html-to-image": "1.11.13",
    "laravel-echo": "^2.5.0",
    "pusher-js": "^8.6.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.10.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "~2.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "marked": "^15.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZionEX Suite",
  "version": "1.0.3",
  "identifier": "com.synclytics.zionex.backoffice",
  "build": {
    "frontendDist": "setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SyncLytics",
    "shortDescription": "ZionEX Suite",
    "longDescription": "ZionEX Suite in its own window: it opens your business server, keeps exports in Downloads and records which computer is used.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "copyright": "Copyright © SyncLytics"
  }
}

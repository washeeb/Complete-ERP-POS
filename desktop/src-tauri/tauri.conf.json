{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZionEX Back Office",
  "version": "1.0.1",
  "identifier": "com.synclytics.zionex.backoffice",
  "build": {
    "frontendDist": "setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SyncLytics",
    "shortDescription": "ZionEX back office",
    "longDescription": "The ZionEX back office in its own window: it opens your business server's back office, keeps exports in Downloads and records which computer is used.",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "copyright": "Copyright © SyncLytics"
  }
}

APP_NAME="Synclytics ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live updates (tills, store, back office). Run the WebSocket server with: php artisan reverb:start
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pilot support (Phase 14): problem reports and the evening pilot report, when the go-live plan names no address.
ERP_SUPPORT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Synclytics ERP node ---
# hq | branch | standalone
ERP_NODE_ROLE=hq
# Short unique id for this node; stamped on every record as origin_node
ERP_NODE_ID=HQ
# Audit chain HMAC key. Generate with: php artisan erp:audit-key  (back it up; never change it)
ERP_AUDIT_KEY=

# --- Reverb WebSocket server (php artisan reverb:install fills these) ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
# Queue/cache: database works everywhere; use redis where Redis/Memurai is installed.

# Licensing (docs/licensing.md). Development builds only: the public half of the development signing key.
LICENSE_DEV_PUBLIC_KEY=
# Synclytics licence server only (never on customer installations):
LICENSE_SERVER=false
LICENSE_PRIVATE_KEY_PATH=
LICENSE_KID=

# AI (Phase 11). Claude is used only if switched on in System > Settings > AI with a monthly budget. Leave empty for no cloud AI.
ANTHROPIC_API_KEY=

# Backups (Phase 13). Create the passphrase with: php artisan erp:backup:key. BACKUP_PG_BIN: PostgreSQL's bin folder on Windows.
BACKUP_PASSPHRASE=
BACKUP_PG_BIN=
BACKUP_TIME=02:00
BACKUP_KEEP_LOCAL=7

# GRA E-VAT (Phase 13), from GRA when the business is onboarded. Mode: System > Settings > GRA E-VAT.
GRA_EVAT_URL=
GRA_EVAT_KEY=
GRA_EVAT_TIN=
GRA_EVAT_TIMEOUT=8
